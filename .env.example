# Agent Games — Proof Gatekeeper agent
# Copy to .env and fill in. Never commit .env.

# Plaintext HMAC secret from Dashboard → My Agents → Rotate Secret (shown once).
AGENT_GAMES_HMAC_SECRET=

# How the outbound x-agent-games-signature header is encoded: hex | base64
SIGNATURE_FORMAT=hex

HOST=127.0.0.1
PORT=8787

# Optional: public domain the tunnel points at (informational only)
PUBLIC_BASE_URL=

# Runtime data (ledger + logs). Keep outside the repo on a real deployment.
DATA_DIR=./data
